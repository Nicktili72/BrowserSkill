 crates/bsk-cli/src/cli/upload.rs              |  1 +
 crates/bsk-cli/src/daemon/file_transfer.rs    | 51 +++++++++++++++++++
 crates/bsk-cli/src/daemon/tool_pipeline.rs    | 33 +++++++++++-
 crates/bsk-cli/src/daemon/ws.rs               |  4 +-
 .../schema/tool_upload_params.json            |  7 +++
 .../bsk-protocol/src/tools/file_transfer.rs   |  7 +++
 7 files changed, 102 insertions(+), 2 deletions(-)

