From baea5a42faade27b6307faf4240427e4b50e172b Mon Sep 17 00:00:00 2001
From: NickT72 <35966711+Nicktili72@users.noreply.github.com>
Date: Sun, 22 Nov 2026 14:21:10 +0200
Subject: [PATCH] daemon: inline upload bytes for Safari browsers

Safari's sandboxed app extension cannot read the staged_path the daemon
injects into tool.upload, so for browsers whose handshake name is Safari
the daemon also sends each file's bytes as UploadFile.data_base64
(bounded at 16 MiB per call; larger uploads get an invalid_params error
that says so). Other browsers are unaffected. The new field is
daemon-injected and never agent-facing; schema regenerated.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 crates/bsk-cli/src/cli/upload.rs              |  1 +
 crates/bsk-cli/src/daemon/ipc.rs              | 33 +++++++++++++++++++
 .../schema/tool_upload_params.json            |  7 ++++
 .../bsk-protocol/src/tools/file_transfer.rs   |  7 ++++
 4 files changed, 48 insertions(+)

diff --git a/crates/bsk-cli/src/cli/upload.rs b/crates/bsk-cli/src/cli/upload.rs
index 7249a8d..3ac2aaf 100644
--- a/crates/bsk-cli/src/cli/upload.rs
+++ b/crates/bsk-cli/src/cli/upload.rs
@@ -87,6 +87,7 @@ pub fn dispatch(args: UploadArgs, format: Format) -> Result<(), CliError> {
                 transfer_id: id.clone(),
                 name: name.clone(),
                 staged_path: None,
+                data_base64: None,
             })
             .collect(),
         mode: args.mode.into(),
diff --git a/crates/bsk-cli/src/daemon/ipc.rs b/crates/bsk-cli/src/daemon/ipc.rs
index b6350ce..f813896 100644
--- a/crates/bsk-cli/src/daemon/ipc.rs
+++ b/crates/bsk-cli/src/daemon/ipc.rs
@@ -16,6 +16,7 @@
 //! * `session.start` / `session.stop` / `session.stop_all` / `session.list` (M5)
 //! * `browser.list` (M4)
 
+use base64::Engine;
 use std::future::Future;
 use std::path::PathBuf;
 use std::pin::Pin;
@@ -38,6 +39,10 @@ use serde::{Deserialize, Serialize};
 use serde_json::Value;
 use tokio::sync::Notify;
 use tokio::task::JoinHandle;
+
+/// Cap on bytes inlined into one tool.upload for a Safari browser (base64 grows
+/// it by a third; the WebSocket message limit is 64 MiB).
+const SAFARI_INLINE_UPLOAD_MAX: u64 = 16 * 1024 * 1024;
 use tracing::{debug, warn};
 
 use super::abort::AbortRegistry;
@@ -483,7 +488,35 @@ async fn handle_tool_dispatch(
             Ok(v) => v,
             Err(err) => return ResponseBody::Err(err),
         };
+        // Safari's sandboxed extension cannot read `staged_path`, so for Safari
+        // browsers the bytes travel inline (bounded; see SAFARI_INLINE_UPLOAD_MAX).
+        let inline_bytes = state
+            .sessions
+            .get(&session_id)
+            .and_then(|s| state.browsers.get(&s.browser_id))
+            .is_some_and(|b| b.browser_name.eq_ignore_ascii_case("safari"));
+        let mut inline_total: u64 = 0;
         for (file, path) in upload.files.iter_mut().zip(paths) {
+            if inline_bytes {
+                let size = match std::fs::metadata(&path) {
+                    Ok(m) => m.len(),
+                    Err(err) => return ResponseBody::Err(invalid_params(format!("cannot read staged upload: {err}"))),
+                };
+                inline_total = inline_total.saturating_add(size);
+                if inline_total > SAFARI_INLINE_UPLOAD_MAX {
+                    return ResponseBody::Err(invalid_params(format!(
+                        "Safari uploads are limited to {} MiB per call (this call: {} MiB)",
+                        SAFARI_INLINE_UPLOAD_MAX / (1024 * 1024),
+                        inline_total.div_ceil(1024 * 1024),
+                    )));
+                }
+                match std::fs::read(&path) {
+                    Ok(bytes) => {
+                        file.data_base64 = Some(base64::engine::general_purpose::STANDARD.encode(bytes));
+                    }
+                    Err(err) => return ResponseBody::Err(invalid_params(format!("cannot read staged upload: {err}"))),
+                }
+            }
             file.staged_path = Some(path.to_string_lossy().into_owned());
         }
         params = serde_json::to_value(upload).unwrap_or(Value::Null);
diff --git a/crates/bsk-protocol/schema/tool_upload_params.json b/crates/bsk-protocol/schema/tool_upload_params.json
index dd784b9..bcfc07f 100644
--- a/crates/bsk-protocol/schema/tool_upload_params.json
+++ b/crates/bsk-protocol/schema/tool_upload_params.json
@@ -55,6 +55,13 @@
         "transfer_id"
       ],
       "properties": {
+        "data_base64": {
+          "description": "Daemon-injected, Safari only: the file's bytes (standard base64) for extensions that cannot read `staged_path` (a sandboxed Safari app extension has no filesystem access). Never agent-facing.",
+          "type": [
+            "string",
+            "null"
+          ]
+        },
         "name": {
           "type": "string"
         },
diff --git a/crates/bsk-protocol/src/tools/file_transfer.rs b/crates/bsk-protocol/src/tools/file_transfer.rs
index e2cd97c..6d7b5f7 100644
--- a/crates/bsk-protocol/src/tools/file_transfer.rs
+++ b/crates/bsk-protocol/src/tools/file_transfer.rs
@@ -13,6 +13,11 @@ pub struct UploadFile {
     pub name: String,
     #[serde(default, skip_serializing_if = "Option::is_none")]
     pub staged_path: Option<String>,
+    /// Daemon-injected, Safari only: the file's bytes (standard base64) for
+    /// extensions that cannot read `staged_path` (a sandboxed Safari app
+    /// extension has no filesystem access). Never agent-facing.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub data_base64: Option<String>,
 }
 
 #[derive(Debug, Default, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
@@ -166,6 +171,7 @@ mod tests {
                 transfer_id: "tr_1".into(),
                 name: "image.png".into(),
                 staged_path: None,
+                data_base64: None,
             }],
             mode: UploadMode::Input,
             timeout_ms: None,
@@ -187,6 +193,7 @@ mod tests {
                 transfer_id: "tr_1".into(),
                 name: "image.png".into(),
                 staged_path: None,
+                data_base64: None,
             }],
             mode: UploadMode::Drop,
             timeout_ms: None,
