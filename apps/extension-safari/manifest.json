{
  "manifest_version": 2,
  "name": "BrowserSkill for Safari",
  "version": "0.1.0",
  "description": "Lets bsk (BrowserSkill CLI/daemon) drive Safari for Hermes Agent, Claude Code, Cursor, Codex and other agent harnesses.",
  "icons": { "128": "icon-128.png" },
  "permissions": ["tabs", "storage", "<all_urls>"],
  "browser_specific_settings": { "safari": { "strict_min_version": "16.4" } },
  "background": { "scripts": ["protocol.js", "background.js"], "persistent": true },
  "browser_action": { "default_title": "BrowserSkill for Safari" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ]
}
