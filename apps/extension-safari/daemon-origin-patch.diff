From b3e924018848d7f4211da305ad4bfc5f015966e1 Mon Sep 17 00:00:00 2001
From: NickT72 <35966711+Nicktili72@users.noreply.github.com>
Date: Sun, 22 Nov 2026 14:52:51 +0200
Subject: [PATCH] daemon: accept safari-web-extension:// origins on the
 extension WebSocket

origin_allowed() only recognised chrome-extension:// with a 32-char a-p id.
Safari Web Extension pages report their origin as safari-web-extension://<UUID>
(lowercase 8-4-4-4-12 hex, assigned per build), so the daemon rejected every
Safari connection with 403 before the handshake. Adds the UUID shape check next
to the Chrome one; chrome-extension:// behaviour is unchanged. Like the Chrome
check this is only a filter against ordinary web pages; peer authorization
still decides who may connect.
---
 crates/bsk-cli/src/daemon/ws.rs | 34 ++++++++++++++++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/crates/bsk-cli/src/daemon/ws.rs b/crates/bsk-cli/src/daemon/ws.rs
index 59ca61e8..f94fdf98 100644
--- a/crates/bsk-cli/src/daemon/ws.rs
+++ b/crates/bsk-cli/src/daemon/ws.rs
@@ -45,9 +45,25 @@ pub(super) fn origin_allowed(origin: &str) -> bool {
     {
         return true;
     }
+    // Safari Web Extension pages report `safari-web-extension://<UUID>`
+    // (lowercase, 8-4-4-4-12 hex groups); the UUID is assigned per build.
+    if let Some(rest) = origin.strip_prefix("safari-web-extension://")
+        && is_lowercase_uuid(rest)
+    {
+        return true;
+    }
     false
 }
 
+fn is_lowercase_uuid(s: &str) -> bool {
+    let groups: Vec<&str> = s.split('-').collect();
+    let lens = [8, 4, 4, 4, 12];
+    groups.len() == lens.len()
+        && groups.iter().zip(lens).all(|(g, len)| {
+            g.len() == len && g.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase())
+        })
+}
+
 /// Explain a failed bind on the default daemon port, which the OS — not bsk —
 /// usually owns.
 ///
@@ -317,7 +333,7 @@ async fn handle_connection(
         if !origin_allowed(&origin) {
             warn!(?origin, "rejecting WS upgrade with disallowed origin");
             let mut err = ErrorResponse::new(Some(
-                "Origin not in chrome-extension allow-list".to_string(),
+                "Origin not in chrome-extension/safari-web-extension allow-list".to_string(),
             ));
             *err.status_mut() = StatusCode::FORBIDDEN;
             return Err(err);
@@ -1291,6 +1307,22 @@ mod tests {
     fn origin_allowlist_rejects_local_web_pages() {
         assert!(!origin_allowed("http://localhost"));
     }
+
+    #[test]
+    fn origin_allowlist_accepts_safari_web_extension_uuid() {
+        assert!(origin_allowed(
+            "safari-web-extension://3610fd31-0161-4c6b-919a-ee9a3edb2c19"
+        ));
+    }
+
+    #[test]
+    fn origin_allowlist_rejects_safari_uppercase_or_malformed_uuid() {
+        assert!(!origin_allowed(
+            "safari-web-extension://3610FD31-0161-4C6B-919A-EE9A3EDB2C19"
+        ));
+        assert!(!origin_allowed("safari-web-extension://not-a-uuid"));
+        assert!(!origin_allowed("safari-web-extension://"));
+    }
 }
 
 #[cfg(test)]
